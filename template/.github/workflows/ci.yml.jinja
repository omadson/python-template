name: CI

on: [pull_request]

jobs:
{%- if project_type in ["package", "cli"] %}
  commitlint:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v5
      with:
        fetch-depth: '0'
    - uses: wagoid/commitlint-github-action@v6.2.1
{%- endif %}

  tests:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v5
      with:
        fetch-depth: '0'
    - uses: astral-sh/setup-uv@v8.3.2
      with:
        enable-cache: true
    - run: uv run pytest{% if project_type in ["package", "cli", "data-science"] %} --cov={{ package_module }}{% endif %}

  linter:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v5
      with:
        fetch-depth: '0'
    - uses: astral-sh/setup-uv@v8.3.2
      with:
        enable-cache: true
    - run: |
        uv run ruff check .
        uv run ruff format --check .
